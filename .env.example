# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 32 random bytes, base64. Encrypts stored GitHub/Vercel tokens.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Protects /api/cron/sync. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
