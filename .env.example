# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 32 random bytes, base64. Encrypts stored GitHub/Vercel tokens.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Protects /api/cron/sync. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# GitHub App (Settings -> Developer settings -> GitHub Apps -> your app)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Full PEM contents; literal "\n" sequences are accepted.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Optional: the GitHub Marketplace listing webhook's own secret (set by hand in the listing
# form; it may only sign marketplace_purchase and ping events).
MARKETPLACE_WEBHOOK_SECRET=

# Fix bounties (PayPal sandbox app: developer.paypal.com -> Apps & Credentials -> Sandbox).
# The client id is also sent to the browser for the PayPal buttons (public by design).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the same app's Webhooks section (events: PAYMENT.PAYOUTS-ITEM.*).
PAYPAL_WEBHOOK_ID=
# Live mode needs BOTH of these; anything else stays on the sandbox.
# PAYPAL_ENV=live
# PAYPAL_ALLOW_LIVE=true
# Verification agent (Groq free tier, OpenAI-compatible API).
GROQ_API_KEY=
# BOUNTY_AGENT_MODEL=openai/gpt-oss-120b

# Operator tools (/dashboard/admin): comma-separated GitHub logins. Unset = disabled.
ADMIN_GITHUB_LOGINS=
